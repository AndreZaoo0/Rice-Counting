{
  "name": "rice-counting",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite dev --port 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy --warm-cache",
    "deploy:response-store": "cf deploy --prebuilt --mode production --worker rice-counting-response-store"
  },
  "dependencies": {
    "@cloudflare/workers-response-store": "^1.1.4",
    "@vinext/cloudflare": "^1.3.0",
    "next": "16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "vinext": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "cf": "^1.0.0-beta.26",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "postcss": "^8.5.32",
    "typescript": "^5",
    "vite": "8.3.0",
    "vite-css-modules": "^1.16.1"
  },
  "packageManager": "npm@11.20.0",
  "type": "module",
  "allowScripts": {
    "unrs-resolver": true,
    "workerd": true
  }
}
